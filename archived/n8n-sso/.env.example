# Best practice is to copy this file to .env and change these values

# Encrypts credentials n8n stores (API keys, OAuth tokens, etc). Generate
# with `openssl rand -base64 32`. Changing this after the fact makes
# existing stored credentials unreadable - back it up.
N8N_ENCRYPTION_KEY=changeme

POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme
POSTGRES_DB=n8n
