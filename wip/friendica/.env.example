# Best practice is to copy this file to .env and change these values

# Public URL Friendica will be reachable at. Set this to the REAL,
# final domain now - Friendica bakes this into the database at install
# time and does not reliably support changing it afterwards (base URL
# is used for session/CSRF validation, not just link generation). This
# stays true even though the instance starts out gated behind Authelia
# with federation effectively off - see SETUP.md.
FRIENDICA_URL=https://friendica.example.com

# Your email - becomes the admin account's login once you complete
# setup at https://friendica.${DOMAIN} (behind Authelia during phase 1).
FRIENDICA_ADMIN_MAIL=changeme@example.com

# format is jdbc-style host/user/db, must match the MARIADB_* values below
MYSQL_HOST=friendica-mariadb
MYSQL_DATABASE=friendica
MYSQL_USER=friendica # must match MARIADB_USER
MYSQL_PASSWORD=changeme # must match MARIADB_PASSWORD

# Used by the friendica-mariadb container itself - must mirror the
# MYSQL_* values above (same credentials, different var names expected
# by the two images).
MARIADB_DATABASE=friendica
MARIADB_USER=friendica
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme-root

# --- Optional: outgoing mail (password resets, notifications) ---
# Not required for install. Without it, Friendica's admin panel will
# just show a warning that mail isn't configured. Uncomment and fill in
# to enable it later.
# SMTP=smtp.example.com
# SMTP_PORT=587
# SMTP_DOMAIN=example.com
# SMTP_AUTH_USER=changeme
# SMTP_AUTH_PASS=changeme
