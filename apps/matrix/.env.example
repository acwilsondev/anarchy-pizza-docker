# Postgres credentials for Synapse's database.
#
# IMPORTANT: Synapse's homeserver.yaml has no env-var substitution, so
# POSTGRES_PASSWORD below and the `database.args.password` you set by hand
# in the generated homeserver.yaml (see SETUP.md) must be the same value,
# kept in sync manually. That mismatch - a real password committed straight
# into a tracked homeserver.yaml - is exactly what happened to this repo's
# archived/matrix config; SETUP.md's whole point is to avoid repeating it.
POSTGRES_USER=synapse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=synapse
