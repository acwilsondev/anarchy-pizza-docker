# MinIO root credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# Console OIDC via Authelia - the client must be registered in
# apps/authelia's identity_providers.yml (host-only, not in git) first,
# and a MinIO policy matching each LLDAP group name that should get
# console access must exist (`mc admin policy create`) - MinIO maps the
# OIDC groups claim directly to policy names, no auto-provisioning.
MINIO_IDENTITY_OPENID_CLIENT_SECRET=change-me
