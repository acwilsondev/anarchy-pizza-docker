# Generate with `openssl rand -hex 32` - required, Homarr won't start without it
SECRET_ENCRYPTION_KEY=changeme

# OIDC via Authelia - the client must be registered in
# apps/authelia's identity_providers.yml (host-only, not in git) first.
# CLIENT_SECRET is the *plaintext* Homarr sends; Authelia stores only a
# PBKDF2 hash of it, generated via
# `docker exec authelia authelia crypto hash generate pbkdf2 --password '...'`
AUTH_OIDC_ISSUER=https://auth.example.com
AUTH_OIDC_CLIENT_ID=homarr
AUTH_OIDC_CLIENT_SECRET=changeme
