# Best practice is to copy this file to .env and change these values

# Public URL Vikunja will be reachable at (used for links in emails, CalDAV, etc.)
# Trailing slash required.
VIKUNJA_SERVICE_PUBLICURL=https://vikunja.example.com/

# Generate a secure random secret, e.g. `openssl rand -base64 32`
VIKUNJA_SERVICE_SECRET=changeme

# Set to false once you've created your account(s)
VIKUNJA_SERVICE_ENABLEREGISTRATION=true

# OIDC via Authelia - the client must be registered in
# apps/authelia's identity_providers.yml (host-only, not in git) first.
# CLIENTSECRET is the *plaintext* Vikunja sends; Authelia stores only a
# PBKDF2 hash of it, generated via
# `docker exec authelia authelia crypto hash generate pbkdf2 --password '...'`
VIKUNJA_AUTH_OPENID_ENABLED=true
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_NAME=Authelia
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_AUTHURL=https://auth.example.com
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_CLIENTID=vikunja
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_CLIENTSECRET=changeme
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_SCOPE="openid profile email"
# Links an OIDC login to an existing local account by matching email,
# instead of always creating a new account. Only usernamefallback (not
# used here - it lets the provider claim any local account by username,
# a hijacking risk) is riskier; emailfallback alone is safe once your
# LDAP/OIDC identity's email matches the local account's email.
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_EMAILFALLBACK=true

# format is jdbc-style host/user/db, must match the POSTGRES_* values below
VIKUNJA_DATABASE_TYPE=postgres
VIKUNJA_DATABASE_HOST=vikunja-postgresql
VIKUNJA_DATABASE_USER=vikunja # must match POSTGRES_USER
VIKUNJA_DATABASE_PASSWORD=vikunja # must match POSTGRES_PASSWORD
VIKUNJA_DATABASE_DATABASE=vikunja # must match POSTGRES_DB

POSTGRES_USER=vikunja
POSTGRES_PASSWORD=vikunja
POSTGRES_DB=vikunja
