# LDAP base DN, derived from your domain (e.g. anarchy.pizza -> dc=anarchy,dc=pizza)
LLDAP_BASE_DN=dc=example,dc=com

# Break-glass superadmin for LLDAP itself (its own "admin" user, separate from
# any regular accounts like aaron/testuser). Rarely used day-to-day.
LLDAP_ADMIN_EMAIL=admin@example.com
LLDAP_ADMIN_PASSWORD=changeme

# This host's Tailscale IP (`tailscale ip -4`) - the admin web UI binds
# here only, never to a public/LAN interface.
TAILSCALE_IP=100.64.0.1
